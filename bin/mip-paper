#!/usr/bin/env bash
set -euo pipefail

readonly APP_ID='mip-paper'
readonly SERVICE_NAME='mip-paper.service'
readonly INSTALL_MODE="${MIP_PAPER_MODE:-source}"

script_directory=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
readonly LOCAL_PREFIX="${MIP_PAPER_LOCAL_PREFIX:-$HOME/.local}"
readonly INSTALL_ROOT="${MIP_PAPER_INSTALL_ROOT:-$LOCAL_PREFIX/lib/$APP_ID}"
readonly LAUNCHER_PATH="${MIP_PAPER_LAUNCHER_PATH:-$LOCAL_PREFIX/bin/$APP_ID}"
readonly CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
readonly CONFIG_DIRECTORY="$CONFIG_HOME/$APP_ID"
readonly CONFIG_PATH="$CONFIG_DIRECTORY/config.json"
readonly WEATHER_CREDENTIALS_PATH="$CONFIG_DIRECTORY/weather-credentials.json"
readonly DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
readonly DATA_DIRECTORY="$DATA_HOME/$APP_ID"
readonly WALLPAPER_PATH="$DATA_DIRECTORY/wallpaper"
readonly CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
readonly CACHE_DIRECTORY="$CACHE_HOME/$APP_ID"
readonly SERVICE_DIRECTORY="$CONFIG_HOME/systemd/user"
readonly SERVICE_PATH="${MIP_PAPER_SERVICE_PATH:-$SERVICE_DIRECTORY/$SERVICE_NAME}"
readonly KWIN_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
readonly KWIN_SCRIPT_PATH="$KWIN_DATA_HOME/kwin/scripts/$APP_ID"
readonly KWIN_CONFIG_PATH="${KWIN_CONFIG_FILE:-$CONFIG_HOME/kwinrc}"

if [[ -n "${MIP_PAPER_SOURCE_ROOT:-}" ]]; then
  SOURCE_ROOT=$MIP_PAPER_SOURCE_ROOT
elif [[ -f "$script_directory/../package.json" ]]; then
  SOURCE_ROOT=$(cd -- "$script_directory/.." && pwd -P)
else
  SOURCE_ROOT=$INSTALL_ROOT
fi
readonly SOURCE_ROOT
readonly KWIN_PACKAGE_SOURCE="${MIP_PAPER_KWIN_SOURCE:-$SOURCE_ROOT/kwin/$APP_ID}"

usage() {
  cat >&2 <<'EOF'
Usage: mip-paper COMMAND [OPTION]

Commands:
  install [--no-start] [--image PATH]
                        Install or update and enable the user service
  uninstall [--purge]   Remove the app; --purge also removes user config
  setup [--image PATH]  Configure and start a pacman-installed copy
  teardown [--purge]    Disable user integration; --purge removes user data
  start                 Start the user service
  stop                  Stop the user service
  restart               Restart the user service
  status                Show the user service status
  doctor                Diagnose the installation and Plasma integration
  wallpaper set PATH    Import and use a JPEG, PNG or WebP image
  wallpaper status      Show the managed wallpaper image status
  probe [OPTION]        Compare renderer scheduling strategies on the live desktop
EOF
  exit 2
}

fail() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

require_safe_paths() {
  [[ -n "${HOME:-}" && "$HOME" == /* && "$HOME" != '/' ]] || fail 'HOME must be an absolute user directory'
  if [[ "$INSTALL_MODE" == source ]]; then
    [[ "$INSTALL_ROOT" == "$HOME"/* && "$INSTALL_ROOT" != "$HOME/.local" ]] || fail 'Unsafe installation path'
  else
    [[ "$INSTALL_MODE" == packaged && "$INSTALL_ROOT" == /* && "$INSTALL_ROOT" != '/' ]] || fail 'Unsafe installation mode or root'
  fi
  [[ "$CONFIG_DIRECTORY" == "$HOME"/* && "$CONFIG_DIRECTORY" != "$HOME/.config" ]] || fail 'Unsafe configuration path'
  [[ "$DATA_DIRECTORY" == "$HOME"/* && "$DATA_DIRECTORY" != "$HOME/.local/share" ]] || fail 'Unsafe data path'
  [[ "$CACHE_DIRECTORY" == "$HOME"/* && "$CACHE_DIRECTORY" != "$HOME/.cache" ]] || fail 'Unsafe cache path'
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "Required command is missing: $1"
}

validate_environment() {
  local command_name
  for command_name in node npm systemctl plasmashell kwin_wayland kreadconfig6 kwriteconfig6; do
    require_command "$command_name"
  done
  [[ "${XDG_SESSION_TYPE:-}" == 'wayland' ]] || fail 'The current session is not Wayland'
  [[ "${XDG_CURRENT_DESKTOP:-}" == *KDE* ]] || fail 'The current desktop is not KDE Plasma'
  plasmashell --version | grep -Eq '(^| )6\.' || fail 'Plasma 6 is required'
  kwin_wayland --version | grep -Eq '(^| )6\.' || fail 'KWin 6 is required'
  systemctl --user show-environment >/dev/null
}

validate_setup_environment() {
  local command_name
  for command_name in node systemctl plasmashell kwin_wayland kreadconfig6 kwriteconfig6; do
    require_command "$command_name"
  done
  [[ "${XDG_SESSION_TYPE:-}" == 'wayland' ]] || fail 'The current session is not Wayland'
  [[ "${XDG_CURRENT_DESKTOP:-}" == *KDE* ]] || fail 'The current desktop is not KDE Plasma'
  plasmashell --version | grep -Eq '(^| )6\.' || fail 'Plasma 6 is required'
  kwin_wayland --version | grep -Eq '(^| )6\.' || fail 'KWin 6 is required'
  systemctl --user show-environment >/dev/null
}

validate_source() {
  local required_path
  for required_path in \
    package.json package-lock.json src/main.mjs src/renderer/index.html \
    config/default.json scripts/kwin-rules.sh scripts/wallpaper-image.mjs \
    src/wallpaper-image.mjs \
    scripts/kwin-script.sh kwin/$APP_ID/metadata.json \
    kwin/$APP_ID/contents/code/main.js bin/mip-paper \
    resources/mip-paper.service.in; do
    [[ -e "$SOURCE_ROOT/$required_path" ]] || fail "Source file is missing: $required_path"
  done
}

render_service() {
  local template=$1 destination=$2 contents
  contents=$(<"$template")
  contents=${contents//@INSTALL_ROOT@/$INSTALL_ROOT}
  printf '%s\n' "$contents" > "$destination"
}

copy_snapshot() {
  local destination=$1
  cp -a \
    "$SOURCE_ROOT/package.json" \
    "$SOURCE_ROOT/package-lock.json" \
    "$SOURCE_ROOT/src" \
    "$SOURCE_ROOT/config" \
    "$SOURCE_ROOT/scripts" \
    "$SOURCE_ROOT/kwin" \
    "$SOURCE_ROOT/bin" \
    "$SOURCE_ROOT/resources" \
    "$destination/"
}

install_app() {
  [[ "$INSTALL_MODE" == source ]] || fail 'This installation is managed by pacman; use setup and teardown'
  local start_after_install=1 image_source=''
  while (($#)); do
    case "$1" in
      --no-start)
        start_after_install=0
        shift
        ;;
      --image)
        (($# >= 2)) || usage
        [[ -z "$image_source" ]] || usage
        image_source=$2
        shift 2
        ;;
      *) usage ;;
    esac
  done

  require_safe_paths
  validate_environment
  validate_source

  if [[ -n "$image_source" ]]; then
    node "$SOURCE_ROOT/scripts/wallpaper-image.mjs" set "$image_source"
  elif ((start_after_install == 1)) \
    && ! node "$SOURCE_ROOT/scripts/wallpaper-image.mjs" status >/dev/null 2>&1; then
    fail 'No wallpaper is configured; use install --image PATH'
  fi

  library_parent=''
  launcher_directory=''
  stage=''
  backup=''
  library_parent=$(dirname -- "$INSTALL_ROOT")
  launcher_directory=$(dirname -- "$LAUNCHER_PATH")
  mkdir -p "$library_parent" "$launcher_directory" "$SERVICE_DIRECTORY" "$CONFIG_DIRECTORY"
  stage=$(mktemp -d "$library_parent/.${APP_ID}-stage.XXXXXX")
  backup=$(mktemp -d "$library_parent/.${APP_ID}-backup.XXXXXX")

  committed=0 mutated=0 kwin_mutated=0 config_created=0 credentials_created=0 had_install=0 had_launcher=0 had_service=0 had_rule=0
  had_kwin_package=0 prior_kwin_enabled=false
  cleanup_install() {
    local exit_code=$?
    set +e
    if ((${committed:-0} == 0 && ${mutated:-0} == 1)); then
      rm -rf -- "$INSTALL_ROOT"
      [[ -e "$backup/app" ]] && mv -- "$backup/app" "$INSTALL_ROOT"
      rm -f -- "$LAUNCHER_PATH" "$SERVICE_PATH"
      [[ -e "$backup/launcher" ]] && mv -- "$backup/launcher" "$LAUNCHER_PATH"
      [[ -e "$backup/service" ]] && mv -- "$backup/service" "$SERVICE_PATH"
      if ((${config_created:-0} == 1)); then rm -f -- "$CONFIG_PATH"; fi
      if ((${credentials_created:-0} == 1)); then rm -f -- "$WEATHER_CREDENTIALS_PATH"; fi
      if ((${had_rule:-0} == 1)); then
        "$SOURCE_ROOT/scripts/kwin-rules.sh" install >/dev/null 2>&1
      else
        "$SOURCE_ROOT/scripts/kwin-rules.sh" remove >/dev/null 2>&1
      fi
      if ((${kwin_mutated:-0} == 1)); then
        rm -rf -- "$KWIN_SCRIPT_PATH"
        if ((${had_kwin_package:-0} == 1)); then
          mv -- "$backup/kwin-script" "$KWIN_SCRIPT_PATH"
        fi
        kwriteconfig6 --file "$KWIN_CONFIG_PATH" --group Plugins \
          --key "${APP_ID}Enabled" --type bool "$prior_kwin_enabled" >/dev/null 2>&1
      fi
      systemctl --user daemon-reload >/dev/null 2>&1
    fi
    [[ -n "${stage:-}" && -d "$stage" ]] && rm -rf -- "$stage"
    [[ -n "${backup:-}" && -d "$backup" ]] && rm -rf -- "$backup"
    exit "$exit_code"
  }
  trap cleanup_install EXIT

  copy_snapshot "$stage"
  npm ci --omit=dev --prefix "$stage"
  node -e "require(process.argv[1])" "$stage/node_modules/electron" >/dev/null
  [[ -f "$stage/node_modules/electron/package.json" ]] || fail 'Electron dependency was not installed'
  [[ -x "$stage/node_modules/electron/dist/electron" ]] || fail 'Electron executable is missing'

  if "$SOURCE_ROOT/scripts/kwin-rules.sh" check >/dev/null 2>&1; then had_rule=1; fi
  if [[ -e "$INSTALL_ROOT" ]]; then mv -- "$INSTALL_ROOT" "$backup/app"; had_install=1; fi
  if [[ -e "$LAUNCHER_PATH" ]]; then cp -a -- "$LAUNCHER_PATH" "$backup/launcher"; had_launcher=1; fi
  if [[ -e "$SERVICE_PATH" ]]; then cp -a -- "$SERVICE_PATH" "$backup/service"; had_service=1; fi
  kwin_mutated=1
  if [[ -e "$KWIN_SCRIPT_PATH" ]]; then
    mv -- "$KWIN_SCRIPT_PATH" "$backup/kwin-script"
    had_kwin_package=1
  fi
  prior_kwin_enabled=$(kreadconfig6 --file "$KWIN_CONFIG_PATH" --group Plugins \
    --key "${APP_ID}Enabled" --default false)
  mutated=1

  mv -- "$stage" "$INSTALL_ROOT"
  stage=''
  install -m 755 "$INSTALL_ROOT/bin/$APP_ID" "$LAUNCHER_PATH.tmp.$$"
  mv -f -- "$LAUNCHER_PATH.tmp.$$" "$LAUNCHER_PATH"
  render_service "$INSTALL_ROOT/resources/$SERVICE_NAME.in" "$SERVICE_PATH.tmp.$$"
  chmod 644 "$SERVICE_PATH.tmp.$$"
  mv -f -- "$SERVICE_PATH.tmp.$$" "$SERVICE_PATH"

  if [[ ! -e "$CONFIG_PATH" ]]; then
    install -m 644 "$INSTALL_ROOT/config/default.json" "$CONFIG_PATH"
    config_created=1
  fi
  if [[ ! -e "$WEATHER_CREDENTIALS_PATH" ]]; then
    install -m 600 /dev/null "$WEATHER_CREDENTIALS_PATH"
    credentials_created=1
  fi

  "$INSTALL_ROOT/scripts/kwin-rules.sh" install
  KWIN_SCRIPT_SOURCE="$INSTALL_ROOT/kwin/$APP_ID" \
    "$INSTALL_ROOT/scripts/kwin-script.sh" install
  systemctl --user daemon-reload
  if ((start_after_install == 1)); then
    systemctl --user reenable --now "$SERVICE_NAME"
  fi

  committed=1
  rm -rf -- "$backup"
  backup=''
  trap - EXIT
  printf 'Installation complete: %s\n' "$INSTALL_ROOT"
  if ((start_after_install == 0)); then
    printf 'Service was not started (--no-start).\n'
  fi
}

uninstall_app() {
  [[ "$INSTALL_MODE" == source ]] || fail 'This installation is managed by pacman; use setup and teardown'
  local purge=0
  if (($# > 1)); then usage; fi
  if (($# == 1)); then
    [[ "$1" == '--purge' ]] || usage
    purge=1
  fi
  require_safe_paths
  require_command systemctl

  systemctl --user disable --now "$SERVICE_NAME" >/dev/null 2>&1 || true
  local rule_helper="$INSTALL_ROOT/scripts/kwin-rules.sh"
  if [[ ! -x "$rule_helper" ]]; then rule_helper="$SOURCE_ROOT/scripts/kwin-rules.sh"; fi
  if [[ -x "$rule_helper" ]]; then "$rule_helper" remove || true; fi
  local coordinator_helper="$INSTALL_ROOT/scripts/kwin-script.sh"
  local coordinator_source="$INSTALL_ROOT/kwin/$APP_ID"
  if [[ ! -x "$coordinator_helper" ]]; then
    coordinator_helper="$SOURCE_ROOT/scripts/kwin-script.sh"
    coordinator_source="$SOURCE_ROOT/kwin/$APP_ID"
  fi
  if [[ -x "$coordinator_helper" ]]; then
    KWIN_SCRIPT_SOURCE="$coordinator_source" "$coordinator_helper" remove || true
  else
    rm -rf -- "$KWIN_SCRIPT_PATH"
    kwriteconfig6 --file "$KWIN_CONFIG_PATH" --group Plugins \
      --key "${APP_ID}Enabled" --type bool false >/dev/null 2>&1 || true
  fi
  rm -rf -- "$KWIN_SCRIPT_PATH"

  rm -f -- "$SERVICE_PATH" "$LAUNCHER_PATH"
  rm -rf -- "$INSTALL_ROOT"
  systemctl --user daemon-reload
  if ((purge == 1)); then
    rm -f -- "$CONFIG_PATH" "$WEATHER_CREDENTIALS_PATH"
    rmdir -- "$CONFIG_DIRECTORY" 2>/dev/null || true
    rm -rf -- "$DATA_DIRECTORY"
  fi
  printf 'Uninstallation complete.\n'
}

setup_app() {
  [[ "$INSTALL_MODE" == packaged ]] || fail 'Source installations use install instead of setup'
  local image_source=''
  if (($# > 2)); then usage; fi
  if (($#)); then
    [[ "$1" == '--image' && $# == 2 ]] || usage
    image_source=$2
  fi

  require_safe_paths
  validate_setup_environment
  [[ -f "$SOURCE_ROOT/config/default.json" ]] || fail 'Packaged default configuration is missing'
  [[ -x "$SOURCE_ROOT/scripts/kwin-rules.sh" ]] || fail 'Packaged KWin rule helper is missing'
  [[ -x "$SOURCE_ROOT/scripts/kwin-script.sh" ]] || fail 'Packaged KWin script helper is missing'
  [[ -f "$SERVICE_PATH" ]] || fail 'Packaged systemd user unit is missing'
  [[ -f "$KWIN_PACKAGE_SOURCE/metadata.json" ]] || fail 'Packaged KWin coordinator is missing'
  [[ -f "$KWIN_PACKAGE_SOURCE/contents/code/main.js" ]] || fail 'Packaged KWin coordinator code is missing'

  if [[ -n "$image_source" ]]; then
    node "$SOURCE_ROOT/scripts/wallpaper-image.mjs" set "$image_source"
  elif ! node "$SOURCE_ROOT/scripts/wallpaper-image.mjs" status >/dev/null 2>&1; then
    fail 'No wallpaper is configured; use setup --image PATH'
  fi

  mkdir -p "$CONFIG_DIRECTORY"
  if [[ ! -e "$CONFIG_PATH" ]]; then
    install -m 644 "$SOURCE_ROOT/config/default.json" "$CONFIG_PATH"
  fi
  if [[ ! -e "$WEATHER_CREDENTIALS_PATH" ]]; then
    install -m 600 /dev/null "$WEATHER_CREDENTIALS_PATH"
  else
    chmod 600 "$WEATHER_CREDENTIALS_PATH"
  fi

  "$SOURCE_ROOT/scripts/kwin-rules.sh" install
  KWIN_SCRIPT_SOURCE="$KWIN_PACKAGE_SOURCE" \
    "$SOURCE_ROOT/scripts/kwin-script.sh" enable
  systemctl --user daemon-reload
  systemctl --user enable --now "$SERVICE_NAME"
  printf 'Setup complete for %s.\n' "$APP_ID"
}

teardown_app() {
  [[ "$INSTALL_MODE" == packaged ]] || fail 'Source installations use uninstall instead of teardown'
  local purge=0
  if (($# > 1)); then usage; fi
  if (($# == 1)); then
    [[ "$1" == '--purge' ]] || usage
    purge=1
  fi

  require_safe_paths
  require_command systemctl
  systemctl --user disable --now "$SERVICE_NAME" >/dev/null 2>&1 || true
  "$SOURCE_ROOT/scripts/kwin-rules.sh" remove || true
  KWIN_SCRIPT_SOURCE="$KWIN_PACKAGE_SOURCE" \
    "$SOURCE_ROOT/scripts/kwin-script.sh" disable || true
  systemctl --user daemon-reload

  if ((purge == 1)); then
    rm -rf -- "$CONFIG_DIRECTORY" "$DATA_DIRECTORY" "$CACHE_DIRECTORY"
  fi
  printf 'Teardown complete.\n'
}

service_command() {
  local command_name=$1
  require_command systemctl
  systemctl --user "$command_name" "$SERVICE_NAME"
  case "$command_name" in
    start|restart)
      printf 'Wallpaper service %s requested: %s\n' "$command_name" "$SERVICE_NAME"
      printf 'The wallpaper runs in the desktop background; no application window is opened.\n'
      ;;
  esac
}

wallpaper_command() {
  local action=${1:-}
  case "$action" in
    set)
      (($# == 2)) || usage
      node "$SOURCE_ROOT/scripts/wallpaper-image.mjs" set "$2"
      if systemctl --user is-active "$SERVICE_NAME" >/dev/null 2>&1; then
        systemctl --user restart "$SERVICE_NAME"
      fi
      ;;
    status)
      (($# == 1)) || usage
      node "$SOURCE_ROOT/scripts/wallpaper-image.mjs" status
      ;;
    *) usage ;;
  esac
}

doctor() {
  require_safe_paths
  local failures=0
  check_pass() { printf 'PASS %-18s %s\n' "$1" "$2"; }
  check_fail() { printf 'FAIL %-18s %s\n' "$1" "$2"; failures=1; }
  check_manual() { printf 'MANUAL %-16s %s\n' "$1" "$2"; }
  check_pass mode "$INSTALL_MODE"

  if [[ "${XDG_SESSION_TYPE:-}" == 'wayland' ]]; then
    check_pass session 'Wayland session detected'
  else
    check_fail session 'current session is not Wayland'
  fi
  if [[ "${XDG_CURRENT_DESKTOP:-}" == *KDE* ]]; then
    check_pass desktop 'KDE Plasma desktop detected'
  else
    check_fail desktop 'KDE Plasma was not detected'
  fi

  local command_name
  local -a required_commands=(node systemctl kreadconfig6 kwriteconfig6 pw-cat pw-metadata)
  if [[ "$INSTALL_MODE" == packaged ]]; then
    required_commands+=(electron43)
  else
    required_commands+=(npm)
  fi
  for command_name in "${required_commands[@]}"; do
    if command -v "$command_name" >/dev/null 2>&1; then
      check_pass "command:$command_name" "$(command -v "$command_name")"
    else
      check_fail "command:$command_name" 'required command is missing'
    fi
  done
  if command -v plasmashell >/dev/null 2>&1 && plasmashell --version | grep -Eq '(^| )6\.'; then
    check_pass plasma 'Plasma 6 detected'
  else
    check_fail plasma 'Plasma 6 is unavailable'
  fi
  if command -v kwin_wayland >/dev/null 2>&1 && kwin_wayland --version | grep -Eq '(^| )6\.'; then
    check_pass kwin 'KWin 6 detected'
  else
    check_fail kwin 'KWin 6 is unavailable'
  fi

  local runtime_root=$INSTALL_ROOT
  if [[ "$INSTALL_MODE" == packaged ]]; then runtime_root=$SOURCE_ROOT; fi
  if [[ "$INSTALL_MODE" == packaged && -f "$runtime_root/src/main.mjs" ]] \
    && command -v electron43 >/dev/null 2>&1; then
    check_pass snapshot "$runtime_root (system electron43)"
  elif [[ "$INSTALL_MODE" == source && -d "$runtime_root" \
    && -f "$runtime_root/src/main.mjs" \
    && -x "$runtime_root/node_modules/electron/dist/electron" ]]; then
    check_pass snapshot "$runtime_root"
  else
    check_fail snapshot 'installed application snapshot is incomplete'
  fi
  if [[ -f "$CONFIG_PATH" && -f "$runtime_root/src/config.mjs" ]] \
    && node --input-type=module - "$runtime_root/src/config.mjs" "$CONFIG_PATH" <<'NODE'
const [, , modulePath, configPathname] = process.argv;
const { loadConfig } = await import(`file://${modulePath}`);
await loadConfig(configPathname);
NODE
  then
    check_pass config "$CONFIG_PATH"
  else
    check_fail config 'configuration is missing or invalid'
  fi
  if [[ -f "$WEATHER_CREDENTIALS_PATH" ]] \
    && node --input-type=module - "$WEATHER_CREDENTIALS_PATH" <<'NODE'
import { readFile, stat } from 'node:fs/promises';
const pathname = process.argv[2];
const metadata = await stat(pathname);
if ((metadata.mode & 0o077) !== 0) process.exit(1);
const value = JSON.parse(await readFile(pathname, 'utf8'));
if (typeof value.apiHost !== 'string' || !/^[a-z0-9.-]+$/i.test(value.apiHost)) process.exit(1);
if (typeof value.apiKey !== 'string' || value.apiKey.trim() === '') process.exit(1);
NODE
  then
    check_pass weather-credentials "$WEATHER_CREDENTIALS_PATH"
  else
    check_fail weather-credentials 'credentials are missing, invalid, or not mode 0600'
  fi
  if [[ -f "$runtime_root/scripts/audio-probe.mjs" ]] \
    && node "$runtime_root/scripts/audio-probe.mjs" >/dev/null 2>&1; then
    check_pass audio-output 'default PipeWire sink capture is available'
  else
    check_fail audio-output 'default PipeWire sink capture is unavailable'
  fi
  if [[ -f "$SERVICE_PATH" ]]; then
    check_pass service-file "$SERVICE_PATH"
  else
    check_fail service-file 'systemd user service file is missing'
  fi
  if systemctl --user is-enabled "$SERVICE_NAME" >/dev/null 2>&1; then
    check_pass service-enabled 'user service is enabled'
  else
    check_fail service-enabled 'user service is not enabled'
  fi
  if systemctl --user is-active "$SERVICE_NAME" >/dev/null 2>&1; then
    check_pass service-active 'user service is active'
  else
    check_fail service-active 'user service is not active'
  fi
  local rule_helper="$runtime_root/scripts/kwin-rules.sh"
  if [[ ! -x "$rule_helper" ]]; then rule_helper="$SOURCE_ROOT/scripts/kwin-rules.sh"; fi
  if [[ -x "$rule_helper" ]] && "$rule_helper" check >/dev/null 2>&1; then
    check_pass 'KWin rule' 'project rule is installed'
  else
    check_fail 'KWin rule' 'project rule is missing or invalid'
  fi
  local coordinator_helper="$runtime_root/scripts/kwin-script.sh"
  local coordinator_command=check coordinator_source="$runtime_root/kwin/$APP_ID"
  if [[ "$INSTALL_MODE" == packaged ]]; then
    coordinator_command=check-enabled
    coordinator_source=$KWIN_PACKAGE_SOURCE
  fi
  if [[ -x "$coordinator_helper" ]] \
    && KWIN_SCRIPT_SOURCE="$coordinator_source" "$coordinator_helper" "$coordinator_command" >/dev/null 2>&1; then
    check_pass 'KWin coordinator' 'display coordinator is installed and enabled'
  else
    check_fail 'KWin coordinator' 'display coordinator is missing or disabled'
  fi
  local wallpaper_helper="$runtime_root/scripts/wallpaper-image.mjs"
  if [[ ! -f "$wallpaper_helper" ]]; then wallpaper_helper="$SOURCE_ROOT/scripts/wallpaper-image.mjs"; fi
  if [[ -f "$wallpaper_helper" ]] && node "$wallpaper_helper" status >/dev/null 2>&1; then
    check_pass image "$WALLPAPER_PATH"
  else
    check_fail image 'managed wallpaper is missing or invalid'
  fi

  check_manual 'window stacking' 'verify wallpaper remains below ordinary windows and above the desktop surface'
  check_manual 'panel visibility' 'verify Plasma panel and widgets remain above the wallpaper'
  check_manual 'Alt+Tab' 'verify taskbar, pager, Alt+Tab, and overview isolation'
  check_manual 'mouse input' 'verify interaction and configured mouse passthrough'
  check_manual 'multi-display' 'verify independent windows, scaling, rotation, and hotplug'
  check_manual 'lock/suspend' 'verify lock, suspend, wake, and session restart recovery'
  check_manual 'resource usage' 'measure idle 30 FPS CPU/GPU/memory and battery impact'
  check_manual 'information panel' 'verify nearest-card expansion, reverse collapse, and two rebounds'
  check_manual 'weather data' 'verify Portal location, QWeather attribution, tide, stale, and unavailable states'

  return "$failures"
}

case "${1:-}" in
  install) shift; install_app "$@" ;;
  uninstall) shift; uninstall_app "$@" ;;
  setup) shift; setup_app "$@" ;;
  teardown) shift; teardown_app "$@" ;;
  start|stop|restart|status) command_name=$1; shift; (($# == 0)) || usage; service_command "$command_name" ;;
  doctor) shift; (($# == 0)) || usage; doctor ;;
  wallpaper) shift; wallpaper_command "$@" ;;
  probe) shift; exec node "$SOURCE_ROOT/scripts/render-probe.mjs" "$@" ;;
  *) usage ;;
esac
