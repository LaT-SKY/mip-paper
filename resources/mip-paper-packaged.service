[Unit]
Description=Mip-Paper
After=plasma-workspace.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/electron43 /usr/lib/mip-paper
WorkingDirectory=/usr/lib/mip-paper
Environment=ELECTRON_OZONE_PLATFORM_HINT=auto
KillMode=mixed
Restart=on-failure
RestartSec=3

[Install]
WantedBy=plasma-workspace.target
